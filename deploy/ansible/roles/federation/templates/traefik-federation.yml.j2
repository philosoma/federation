# Generated by the federation Ansible role. Do not edit on the host.
# Traffic always enters through the login door, never directly to Federation.
http:
  routers:
    {{ federation_traefik_router_name }}:
      rule: "Host(`{{ federation_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ federation_traefik_router_name }}
      middlewares:
        - "{{ federation_traefik_mesh_only_middleware }}"
{% if federation_ratelimit_available %}
        - "{{ federation_traefik_ratelimit_middleware }}"
{% endif %}
      tls:
        certResolver: {{ federation_traefik_cert_resolver }}

  services:
    {{ federation_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://oauth2-proxy-federation:4180"

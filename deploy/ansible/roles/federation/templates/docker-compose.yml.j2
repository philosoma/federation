# Generated by the federation Ansible role. Do not edit on the host.
services:
  federation:
    image: "{{ federation_image }}"
    platform: "{{ federation_image_platform }}"
    container_name: federation
    restart: unless-stopped
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 2G
    networks:
      - "{{ federation_traefik_network }}"
    expose:
      - "8090"
    volumes:
      - "{{ federation_compose_dir }}/config.json:/etc/federation/config.json:ro"
      - "{{ federation_app_secrets_dir }}:/run/secrets/federation:ro"
      - "{{ federation_state_dir }}:/var/lib/federation"
      # goatbuilder reads the core router through docker (preflight, phase 3). The
      # app runs on the core, so it uses the local daemon.
      - "{{ federation_docker_socket }}:/var/run/docker.sock"
    group_add:
      - "{{ federation_docker_gid }}"
    environment:
      FED_SITE: "{{ site_id }}"
      FED_ROUTER_DOCKER_HOST: "unix:///var/run/docker.sock"
      FED_ROUTER_CONTAINER: "{{ federation_router_container }}"
      FED_CONFIG_REPO: "{{ federation_config_repo }}"
      FED_CONTACT: "{{ federation_contact }}"
      FED_EDGE_NAME: "{{ federation_edge_name }}"
      FED_EDGE_HOST: "{{ federation_edge_host }}"
      FED_EDGE_USER: "{{ federation_edge_user }}"
      FED_CORE_NAME: "{{ federation_core_name }}"
      FED_CORE_HOST: "{{ federation_core_host }}"
      FED_CORE_USER: "{{ federation_core_user }}"
      FED_PUBLIC_NAME: "{{ federation_public_name }}"
      FED_FIPS_WAIVER: "{{ federation_fips_waiver }}"
    healthcheck:
      test: ["CMD", "/app/federation", "-healthcheck", "-listen", ":8090"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      - "traefik.enable=false"

networks:
  "{{ federation_traefik_network }}":
    external: true
    name: "{{ federation_traefik_network }}"

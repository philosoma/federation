[Unit]
Description=Copy released internal topics into federation release sets
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/release-bridge/release-bridge.py /etc/release-bridge/release-bridge.json
DynamicUser=yes
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
